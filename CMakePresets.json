{
  "version": 3,
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "architecture": { "value": "x64", "strategy": "external" },
      "cacheVariables": { "CMAKE_CXX_COMPILER": "cl.exe" }
    },
    { "name": "x64-RelWithDebInfo", "inherits": "base", "cacheVariables": { "CMAKE_BUILD_TYPE": "RelWithDebInfo" } }
  ]
}
